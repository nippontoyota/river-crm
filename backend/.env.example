DJANGO_SECRET_KEY=replace-with-a-long-random-secret
JWT_SIGNING_KEY=replace-with-a-separate-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.revera.example,localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=true
SLOW_REQUEST_SECONDS=0.5
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
# Dedicated persistent Celery queue: use Render's internal connection URL.
# Keep this separate from the analytics cache; use noeviction for queued jobs.
REDIS_URL=redis://default:password@redis-host:6379/0
# Upstash TCP/TLS URL (rediss://...), never the REST URL. Set TTL to 0 to disable caching.
CACHE_URL=rediss://default:password@upstash-host:6379
CACHE_TTL_SECONDS=10
SUPABASE_URL=https://project.supabase.co
SUPABASE_SECRET_KEY=server-only-never-expose-to-the-browser
SUPABASE_UPLOAD_BUCKET=crm-imports
CORS_ALLOWED_ORIGINS=https://app.revera.example,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://app.revera.example,http://localhost:3000

# WhatsApp previews need no credentials. Live mode is rejected until a provider is implemented.
WHATSAPP_MODE=preview
WHATSAPP_BUSINESS_NAME=Incheon Mobility
WHATSAPP_LANGUAGE=en
WHATSAPP_TEMPLATE_INTRODUCTION=so_introduction
WHATSAPP_TEMPLATE_REASSIGNMENT=so_reassignment

# Enable after forms, Meta credentials, Redis, worker and scheduler are verified.
INTAKE_ENABLED=false
# Automatic delivery: use celery on web, worker and scheduler.
# The optional database/cron mode is retained for compatibility, not this deployment.
INTAKE_EXECUTION_MODE=celery
# Keep false on all three services. Verify the worker before changing live web overrides.
CELERY_TASK_ALWAYS_EAGER=false
INTAKE_FINGERPRINT_KEY=replace-with-a-stable-random-key-shared-by-web-and-workers
# Values are backend-only. Each website connection must have distinct credentials.
INTAKE_SECRETS_JSON={"main-site":{"active":"replace-with-a-random-secret","retiring":""},"main-meta":{"access_token":"replace-with-authorized-page-token"}}
META_APP_SECRET=
META_VERIFY_TOKEN=
# Explicitly pin a supported version after checking the Meta app dashboard; no default.
META_GRAPH_VERSION=
